# ESPHome build cache -- regenerated on the next compile
/.esphome/

# Optional local secrets used only by custom downstream profiles
/secrets.yaml

# Python bytecode from the tools/ generators
__pycache__/

# uv-managed local Python environment
/.venv/

# Release artifacts assembled by scripts/make_release.py
/dist/
/dist-pages/

# Local design previews and generated architecture pages
/.tmp/
